{
  "name": "endocode",
  "version": "1.0.0",
  "description": "EndoCode — local AI coding agent desktop shell",
  "main": "src/main.js",
  "author": "Kejlo",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "jsonrepair": "^3.13.1"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win dir",
    "pack": "electron-builder --win dir"
  },
  "build": {
    "appId": "dev.endocode.app",
    "productName": "EndoCode",
    "asar": false,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "dir"
      ],
      "signAndEditExecutable": false
    }
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12"
  }
}
